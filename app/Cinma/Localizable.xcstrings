    "Cinma ships without built-in content sources. Add a Stremio addon by URL and optionally your free TMDB API key for rich Turkish/English artwork and calendars.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma ships without built-in content sources. Add a Stremio addon by URL and optionally your free TMDB API key for rich Turkish/English artwork and calendars."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma dahili içerik kaynağı içermez. URL ile bir Stremio eklentisi ve isteğe bağlı olarak zengin Türkçe/İngilizce görseller ile takvim için ücretsiz TMDB API anahtarınızı ekleyin."
          }
        }
      }
    },
    "Cinma ships without content sources. Open Profile → Addons or Settings to add a Stremio addon or TMDB API key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma ships without content sources. Open Profile → Addons or Settings to add a Stremio addon or TMDB API key."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma içerik kaynağı içermez. Stremio eklentisi veya TMDB API anahtarı eklemek için Profil → Eklentiler veya Ayarlar'ı açın."
          }
        }
      }
    },
