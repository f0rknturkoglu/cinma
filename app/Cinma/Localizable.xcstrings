        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma içerik kaynağı içermez. Stremio eklentisi veya TMDB API anahtarı eklemek için Profil → Eklentiler veya Ayarlar'ı açın."
          }
        }
      }
    },
