    "Cinma ships without built-in content sources. Add a Stremio addon, optional TMDB metadata key, and language preference below — you can skip or change everything later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma ships without built-in content sources. Add a Stremio addon, optional TMDB metadata key, and language preference below — you can skip or change everything later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma yerleşik içerik kaynağı olmadan gelir. Aşağıdan bir Stremio eklentisi, isteğe bağlı TMDB anahtarı ve dil tercihi ekleyebilirsiniz; tümünü atlayabilir veya daha sonra değiştirebilirsiniz."
          }
        }
      }
    },
    "Cinma ships without built-in content sources. Set up your addons, optional TMDB metadata key, and preferences below — you can skip or change everything anytime.": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma yerleşik içerik kaynağı olmadan gelir. Eklentilerinizi, isteğe bağlı TMDB anahtarınızı ve tercihlerinizi aşağıda ayarlayın; hepsini istediğiniz zaman atlayabilir veya değiştirebilirsiniz."
          }
        }
      }
    },
    "Cinma ships without content sources. Open Profile → Addons or Settings to add a Stremio addon or TMDB API key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinma ships without content sources. Open Profile → Addons or Settings to add a Stremio addon or TMDB API key."
